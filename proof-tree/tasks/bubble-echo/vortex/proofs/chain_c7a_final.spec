(* ---- C7a theorems: the click film, whole, the puncture export called as one host call, under wasmc ---- *)
theorem VA1_FILM_CLICK
 `!(fs:num->byte list#num#num) (gl:num->wval) (mdl:num->int32) (N:num) (ap:int32)
   (x0:(num->int32)#(num->int32)) (K:num) (n:num) (m0:int64->byte) (a0:int32) (a1:int32) (a2:int32).
     va1_fs_np fs /\ va1_fs_pop fs /\ fs 26 = (va1_f26_mc,0,1) /\
     fs 25 = (va1_f25_mc,3,1) /\ fs 32 = (va1_f32_mc,2,1) /\ fs 34 = (va1_f34_mc,3,0) /\ gl 0 = I32 (word 16384) /\
     mdl 1 = word N /\ 1 <= N /\ N <= 640 /\ 1 <= K /\ K + 520 < 4294967296 /\ n <= 520 /\
     (ap = word 0 \/ K < val ap) /\ va1_np_st (word 0) ap mdl N x0 m0 /\ va1_clean m0 /\
     ~(a0 = word 0 /\ a1 = word 0 /\ a2 = word 0)
     ==> va1_hrun (wasmc fs) (REPLICATE K T)
           (\gl1 m1. va1_hcall (wasmc fs) va1_puncture_mc [I32 a2; I32 a1; I32 a0] (word 0)
              (va1_hrun (wasmc fs) (APPEND (REPLICATE n T) (REPLICATE (n + K) F))
                 (\gl3 m3. gl3 = gl /\ va1_np_st (word 0) ap mdl N x0 m3 /\ va1_clean m3 /\
                           read (bytes32 (word 16404)) m3 = read (bytes32 (word 16404)) m0 /\
                           va1_film_bytes N m0 m3)) gl1 m1) gl m0`;;
theorem VA1_FILM_CLICK_TO_END
 `!(fs:num->byte list#num#num) (gl:num->wval) (mdl:num->int32) (N:num) (ap:int32)
   (x0:(num->int32)#(num->int32)) (K:num) (m0:int64->byte) (a0:int32) (a1:int32) (a2:int32).
     va1_fs_np fs /\ va1_fs_pop fs /\ fs 26 = (va1_f26_mc,0,1) /\
     fs 25 = (va1_f25_mc,3,1) /\ fs 32 = (va1_f32_mc,2,1) /\ fs 34 = (va1_f34_mc,3,0) /\ gl 0 = I32 (word 16384) /\
     mdl 1 = word N /\ 1 <= N /\ N <= 640 /\ 1 <= K /\ K + 520 < 4294967296 /\
     (ap = word 0 \/ K < val ap) /\ va1_np_st (word 0) ap mdl N x0 m0 /\ va1_clean m0 /\
     ~(a0 = word 0 /\ a1 = word 0 /\ a2 = word 0)
     ==> va1_hrun (wasmc fs) (REPLICATE K T)
           (\gl1 m1. va1_hcall (wasmc fs) va1_puncture_mc [I32 a2; I32 a1; I32 a0] (word 0)
              (va1_hrun (wasmc fs) (REPLICATE 520 T)
                 (\gl3 m3. gl3 = gl /\
                    va1_hcall (wasmc fs) va1_tick_forward_mc [] (word 0)
                      (\gl4 m4. gl4 = gl3 /\ m4 = m3 /\
                         va1_hrun (wasmc fs) (REPLICATE (520 + K) F)
                           (\gl5 m5. gl5 = gl /\ va1_np_st (word 0) ap mdl N x0 m5 /\ va1_clean m5 /\
                              read (bytes32 (word 16404)) m5 = read (bytes32 (word 16404)) m0 /\
                              va1_film_bytes N m0 m5) gl4 m4) gl3 m3)) gl1 m1) gl m0`;;
theorem VA1_C7A_SAT
 `!K n. 1 <= K /\ K + 520 < 4294967296 /\ n <= 520
        ==> ?(fs:num->byte list#num#num) (gl:num->wval) (mdl:num->int32) (N:num) (ap:int32)
             (x0:(num->int32)#(num->int32)) (m0:int64->byte) (a0:int32) (a1:int32) (a2:int32).
              va1_fs_np fs /\ va1_fs_pop fs /\ fs 26 = (va1_f26_mc,0,1) /\
              fs 25 = (va1_f25_mc,3,1) /\ fs 32 = (va1_f32_mc,2,1) /\ fs 34 = (va1_f34_mc,3,0) /\ gl 0 = I32 (word 16384) /\
              mdl 1 = word N /\ 1 <= N /\ N <= 640 /\
              (ap = word 0 \/ K < val ap) /\ va1_np_st (word 0) ap mdl N x0 m0 /\ va1_clean m0 /\
              ~(a0 = word 0 /\ a1 = word 0 /\ a2 = word 0)`;;
(* ---- copied verbatim from chain_c4_final.spec (sha256 e22e7110) ---- *)
definition va1_clean
 `va1_clean (m:int64->byte) <=>
    va1_w32s 16408 26 (\k. word 0) m /\ va1_w32s 65536 262144 (\k. word 0) m /\
    va1_w32s 1130496 2048 (\k. word 0) m /\ va1_w32s 1138688 2048 (\k. word 0) m /\
    va1_w32s 1146880 2048 (\k. word 0) m /\ va1_w32s 1155072 2048 (\k. word 0) m /\
    va1_bs ((\k. word 0),(\k. word 0),(\k. word 0),word 0) m`;;
definition va1_film_bytes
 `va1_film_bytes (N:num) (m0:int64->byte) (m:int64->byte) <=>
    !a. a < 4194304 /\ ~(16288 <= a /\ a < 16384) /\ ~(1114112 + 12 * N <= a /\ a < 1122304) /\
        ~(1122304 + 12 * N <= a /\ a < 1130496) /\ ~(1966080 <= a /\ a < 2039808)
        ==> read (bytes8 (word a)) m = read (bytes8 (word a)) m0`;;
definition va1_hcall
 `va1_hcall (step:wasmstate->wasmstate->bool) (code:byte list) (args:wval list) (r:int32)
            (Q:(num->wval)->(int64->byte)->bool) (gl:num->wval) (m:int64->byte) <=>
    ?e decls.
      wasm_entry code = SOME e /\ wasm_decl_vals code = SOME decls /\
      !s0. read wmemsize s0 = 4194304 /\ read wglobals s0 = gl /\ read wmem s0 = m
           ==> eventually step
                 (\s. read wstatus s = WDone /\ read wstack s = [I32 r] /\
                      read wmemsize s = 4194304 /\ Q (read wglobals s) (read wmem s))
                 (wcall_entry code (LENGTH args) 1 args e decls s0)`;;
definition va1_hrun
 `va1_hrun (step:wasmstate->wasmstate->bool) (cs:bool list) (Q:(num->wval)->(int64->byte)->bool) =
    ITLIST (\c R. va1_hcall step (if c then va1_tick_forward_mc else va1_tick_backward_mc) [] (word 1) R) cs Q`;;
definition va1_np_st
 `va1_np_st (t:int32) (ap:int32) (mdl:num->int32) (N:num) (x:(num->int32)#(num->int32)) (m:int64->byte) <=>
    va1_tick t m /\ va1_pop (word 4294967295) ap m /\ va1_mdl mdl m /\ va1_vab N x m`;;
definition va1_fs_np
 `va1_fs_np (fs:num->byte list#num#num) <=>
    fs 9 = (va1_f9_mc,0,0) /\ fs 10 = (va1_f10_mc,0,0) /\ fs 27 = (va1_f27_mc,0,0) /\ fs 28 = (va1_f28_mc,0,0)`;;
theorem VA1_WDECL_VALS_CLAUSES
 `(!code pc. wdecl_vals 0 (code:byte list) pc = SOME ([]:wval list)) /\
  (!k code pc. wdecl_vals (SUC k) code pc =
     wobind (wuleb (wdrop pc code)) (\p.
     wobind (whd (wdrop (pc + SND p) code)) (\t.
     wobind (wdecl_vals k code (pc + SND p + 1)) (\r.
       SOME (APPEND (REPLICATE (FST p) (wzero_of (val (t:byte)))) r)))))`;;
definition wasm_decl_vals
 `wasm_decl_vals (code:byte list) =
    wobind (wuleb code) (\p. wdecl_vals (FST p) code (SND p))`;;
definition wcall_locals
 `wcall_locals (args:wval list) (decls:wval list) (k:num) =
    if k < LENGTH args then EL (LENGTH args - 1 - k) args
    else if k - LENGTH args < LENGTH decls then EL (k - LENGTH args) decls
    else I32 (word 0)`;;
definition wcall_entry
 `wcall_entry (code:byte list) np nr (stk:wval list) e (decls:wval list)
              (s:wasmstate) =
    write wcode code
     (write wpc (word e)
       (write wstack []
         (write wlocals (wcall_locals (wtake np stk) decls)
           (write wlabels []
             (write warity nr
               (write wstatus WRunning s))))))`;;
definition wcall_return
 `wcall_return npc np (c1:wasmstate) (s:wasmstate) =
    if read wstatus c1 = WDone
    then write wpc (word npc)
          (write wstack (APPEND (read wstack c1) (wdrop np (read wstack s)))
            (write wmem (read wmem c1)
              (write wmemsize (read wmemsize c1)
                (write wglobals (read wglobals c1) s))))
    else write wstatus WTrapped
          (write wmem (read wmem c1)
            (write wmemsize (read wmemsize c1)
              (write wglobals (read wglobals c1) s)))`;;
definition wasm_call
 `wasm_call (fs:num->byte list#num#num) f npc (s:wasmstate) (s':wasmstate) <=>
    ?code np nr e decls c1.
      fs f = (code,np,nr) /\ np <= LENGTH (read wstack s) /\
      wasm_entry code = SOME e /\ wasm_decl_vals code = SOME decls /\
      RTC wasm (wcall_entry code np nr (read wstack s) e decls s) c1 /\
      ~(read wstatus c1 = WRunning) /\
      s' = wcall_return npc np c1 s`;;
definition wasmc
 `wasmc (fs:num->byte list#num#num) s s' <=>
    wasm s s' \/
    read wstatus s = WRunning /\
    ?f n. wasm_decode (read wcode s) (val (read wpc s)) = SOME (Wcall f,n) /\
          wasm_call fs f (val (read wpc s) + n) s s'`;;
definition va1_tick
 `va1_tick (t:int32) (m:int64->byte) <=> read (bytes32 (word 16392)) m = t`;;
definition va1_pop
 `va1_pop (pt:int32) (ap:int32) (m:int64->byte) <=>
    read (bytes32 (word 16396)) m = pt /\ read (bytes32 (word 16512)) m = ap`;;
definition va1_mdl
 `va1_mdl (mdl:num->int32) (m:int64->byte) <=>
    !k. k < 1024 ==> read (bytes32 (word (16640 + 4 * k))) m = mdl k`;;
definition va1_vab
 `va1_vab N (x:(num->int32)#(num->int32)) (m:int64->byte) <=>
    (!j. j < 3 * N ==> read (bytes32 (word (1114112 + 4 * j))) m = FST x j) /\
    (!j. j < 3 * N ==> read (bytes32 (word (1122304 + 4 * j))) m = SND x j)`;;
definition wzero_of
 `wzero_of (t:num) =
    if t = 0x7E then I64 (word 0) else if t = 0x7D then F32 (word 0)
    else if t = 0x7C then F64 (word 0) else I32 (word 0)`;;
