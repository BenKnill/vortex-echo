    let k = val (r 7) MOD 2048 in
    ((\w. if 12 * n <= w /\ w < 12 * n + 12 then r (w - 12 * n) else (FST bs) w),
     (\i. if c /\ i = k then word_sub ((FST (SND bs)) i) (r 8) else (FST (SND bs)) i),
     (\i. if c /\ i = k then word_sub ((FST (SND (SND bs))) i) (r 9) else (FST (SND (SND bs))) i),
