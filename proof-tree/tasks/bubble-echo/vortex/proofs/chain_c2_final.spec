definition ve_kd_fwd
 `ve_kd_fwd (K:(num->int32)->num->int32) (D:(num->int32)->num->int32)
            (s:(num->int32)#(num->int32)) =
    let p1 = (\m. word_add (SND s m) (K (FST s) m)) in
    ((\m. word_add (FST s m) (D p1 m)),p1)`;;
