definition va1_rimd
 `va1_rimd (tbl:num->int32) (src:num->int32) (k:num) =
    if ival (src k) > &52371633 then (word 0:int32) else
    let r = if ival (src k) > &0 then src k else (word 0:int32) in
    let j = val (word_and (word_ushr r 17) (word 16380):int32) DIV 4 in
    let a = (word_sx (tbl (128 * k + j)):int64) in
    let b = (word_sx (tbl (128 * k + j + 1)):int64) in
    let v = word_add (word_ishr (word_add (word_mul (word_sub b a)
                                                     (word_zx (word_and r (word 524287):int32)))
