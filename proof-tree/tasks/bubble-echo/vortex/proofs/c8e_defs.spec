definition wasm_calln
 `wasm_calln (fs:num->byte list#num#num) f npc (s:wasmstate) (s':wasmstate) <=>
    ?code np nr e decls c1.
      fs f = (code,np,nr) /\ np <= LENGTH (read wstack s) /\
      wasm_entry code = SOME e /\ wasm_decl_vals code = SOME decls /\
      RTC (wasmf fs) (wcall_entry code np nr (read wstack s) e decls s,[])
                     (c1,[]) /\
      ~(read wstatus c1 = WRunning) /\
      s' = wcall_return npc np c1 s`;;
definition wasm_decl_vals
 `wasm_decl_vals (code:byte list) =
    wobind (wuleb code) (\p. wdecl_vals (FST p) code (SND p))`;;
definition wasmf
 `wasmf (fs:num->byte list#num#num)
        (x:wasmstate#(wasmstate#num#num)list)
        (y:wasmstate#(wasmstate#num#num)list) <=>
    (wasm (FST x) (FST y) /\ SND y = SND x) \/
    (read wstatus (FST x) = WRunning /\
     ?f n code np nr e decls.
       wasm_decode (read wcode (FST x)) (val (read wpc (FST x))) =
         SOME (Wcall f,n) /\
       fs f = (code,np,nr) /\ np <= LENGTH (read wstack (FST x)) /\
       wasm_entry code = SOME e /\ wasm_decl_vals code = SOME decls /\
       FST y = wcall_entry code np nr (read wstack (FST x)) e decls (FST x) /\
       SND y = CONS (FST x,val (read wpc (FST x)) + n,np) (SND x)) \/
    (~(read wstatus (FST x) = WRunning) /\
     ?c npc np k. SND x = CONS (c,npc,np) k /\
                  FST y = wcall_return npc np (FST x) c /\ SND y = k)`;;
definition wasmn
 `wasmn (fs:num->byte list#num#num) s s' <=>
    wasm s s' \/
    read wstatus s = WRunning /\
    ?f n. wasm_decode (read wcode s) (val (read wpc s)) = SOME (Wcall f,n) /\
          wasm_calln fs f (val (read wpc s) + n) s s'`;;
definition wcall_entry
 `wcall_entry (code:byte list) np nr (stk:wval list) e (decls:wval list)
              (s:wasmstate) =
    write wcode code
     (write wpc (word e)
       (write wstack []
         (write wlocals (wcall_locals (wtake np stk) decls)
           (write wlabels []
             (write warity nr
               (write wstatus WRunning s))))))`;;
definition wcall_locals
 `wcall_locals (args:wval list) (decls:wval list) (k:num) =
    if k < LENGTH args then EL (LENGTH args - 1 - k) args
    else if k - LENGTH args < LENGTH decls then EL (k - LENGTH args) decls
    else I32 (word 0)`;;
definition wcall_return
 `wcall_return npc np (c1:wasmstate) (s:wasmstate) =
    if read wstatus c1 = WDone
    then write wpc (word npc)
          (write wstack (APPEND (read wstack c1) (wdrop np (read wstack s)))
            (write wmem (read wmem c1)
              (write wmemsize (read wmemsize c1)
                (write wglobals (read wglobals c1) s))))
    else write wstatus WTrapped
          (write wmem (read wmem c1)
            (write wmemsize (read wmemsize c1)
              (write wglobals (read wglobals c1) s)))`;;
definition wf_ebits
 `wf_ebits (a:N word) = if dimindex(:N) = 32 then 8 else 11`;;
definition wf_exp
 `wf_exp (a:N word) = (val a DIV 2 EXP wf_fbits a) MOD 2 EXP wf_ebits a`;;
definition wf_fbits
 `wf_fbits (a:N word) = dimindex(:N) - 1 - wf_ebits a`;;
definition wf_frac
 `wf_frac (a:N word) = val a MOD 2 EXP wf_fbits a`;;
definition wf_key
 `wf_key (a:N word) =
    if wf_sign a then --(&(val a MOD 2 EXP (dimindex(:N) - 1)))
    else &(val a MOD 2 EXP (dimindex(:N) - 1)):int`;;
definition wf_mag
 `wf_mag (a:N word) =
    let bias = 2 EXP (wf_ebits a - 1) - 1 in
    let sig = if wf_exp a = 0 then wf_frac a else wf_frac a + 2 EXP wf_fbits a in
    let ee = if wf_exp a = 0 then 1 else wf_exp a in
    if bias + wf_fbits a <= ee then sig * 2 EXP (ee - (bias + wf_fbits a))
    else sig DIV 2 EXP ((bias + wf_fbits a) - ee)`;;
definition wf_nan
 `wf_nan (a:N word) <=> wf_exp a = 2 EXP wf_ebits a - 1 /\ ~(wf_frac a = 0)`;;
definition wf_sign
 `wf_sign (a:N word) <=> val a DIV 2 EXP (dimindex(:N) - 1) = 1`;;
definition wf_tbits
 `wf_tbits k = if wf_tidx k < 4 then 32 else 64`;;
definition wf_thi
 `wf_thi k = if EVEN (wf_tidx k) then &2 pow (wf_tbits k - 1) - &1
             else &2 pow wf_tbits k - &1:int`;;
definition wf_tidx
 `wf_tidx k = if 256 <= k then k - 256 else if k <= 0xAB then k - 0xA8 else k - 0xAA`;;
definition wf_tlo
 `wf_tlo k = if EVEN (wf_tidx k) then --(&2 pow (wf_tbits k - 1)) else &0:int`;;
definition wf_trunc
 `wf_trunc (a:N word) = if wf_sign a then --(&(wf_mag a)) else &(wf_mag a):int`;;
definition wfbin
 `wfbin = (@f:num->N word->N word->N word. T)`;;
definition wfcvt
 `wfcvt k (a:M word) : N word =
    if 0xA8 <= k /\ k <= 0xAB \/ 0xAE <= k /\ k <= 0xB1 then iword (wf_trunc a)
    else if 256 <= k /\ k <= 263 then
      (if wf_nan a then word 0
       else iword (max (wf_tlo k) (min (wf_thi k) (wf_trunc a))))
    else if k = 0xB7 then wf_of_int (ival a < &0) (num_of_int (abs (ival a)))
    else if k = 0xB8 then wf_of_int F (val a)
    else (@f:num->M word->N word. T) k a`;;
definition wfrel
 `wfrel k (a:N word) (b:N word) <=>
    if k = 0x5C \/ k = 0x62 then wf_nan a \/ wf_nan b \/ ~(wf_key a = wf_key b)
    else ~wf_nan a /\ ~wf_nan b /\
         (if k = 0x5B \/ k = 0x61 then wf_key a = wf_key b
          else if k = 0x5D \/ k = 0x63 then wf_key a < wf_key b
          else if k = 0x5E \/ k = 0x64 then wf_key a > wf_key b
          else if k = 0x5F \/ k = 0x65 then wf_key a <= wf_key b
          else if k = 0x60 \/ k = 0x66 then wf_key a >= wf_key b
          else F)`;;
definition wfun
 `wfun = (@f:num->N word->N word. T)`;;
definition wtdiv
 `wtdiv (x:int) (y:int) =
    if (x < &0 <=> y < &0) then abs x div abs y else --(abs x div abs y)`;;
definition wzero_of
 `wzero_of (t:num) =
    if t = 0x7E then I64 (word 0) else if t = 0x7D then F32 (word 0)
    else if t = 0x7C then F64 (word 0) else I32 (word 0)`;;
