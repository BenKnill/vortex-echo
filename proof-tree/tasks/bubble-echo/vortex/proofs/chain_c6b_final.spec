(* ---- call models: wasmc (verbatim from va1_seq_final.spec) and wasmn, wasm_calln, wasmf (verbatim from chain_c5p.spec 3a6487ee) ---- *)
definition wzero_of
 `wzero_of (t:num) =
    if t = 0x7E then I64 (word 0) else if t = 0x7D then F32 (word 0)
    else if t = 0x7C then F64 (word 0) else I32 (word 0)`;;
definition wasm_decl_vals
 `wasm_decl_vals (code:byte list) =
    wobind (wuleb code) (\p. wdecl_vals (FST p) code (SND p))`;;
definition wcall_locals
 `wcall_locals (args:wval list) (decls:wval list) (k:num) =
    if k < LENGTH args then EL (LENGTH args - 1 - k) args
    else if k - LENGTH args < LENGTH decls then EL (k - LENGTH args) decls
    else I32 (word 0)`;;
definition wcall_entry
 `wcall_entry (code:byte list) np nr (stk:wval list) e (decls:wval list)
              (s:wasmstate) =
    write wcode code
     (write wpc (word e)
       (write wstack []
         (write wlocals (wcall_locals (wtake np stk) decls)
           (write wlabels []
             (write warity nr
               (write wstatus WRunning s))))))`;;
definition wcall_return
 `wcall_return npc np (c1:wasmstate) (s:wasmstate) =
    if read wstatus c1 = WDone
    then write wpc (word npc)
          (write wstack (APPEND (read wstack c1) (wdrop np (read wstack s)))
            (write wmem (read wmem c1)
              (write wmemsize (read wmemsize c1)
                (write wglobals (read wglobals c1) s))))
    else write wstatus WTrapped
          (write wmem (read wmem c1)
            (write wmemsize (read wmemsize c1)
              (write wglobals (read wglobals c1) s)))`;;
definition wasm_call
 `wasm_call (fs:num->byte list#num#num) f npc (s:wasmstate) (s':wasmstate) <=>
    ?code np nr e decls c1.
      fs f = (code,np,nr) /\ np <= LENGTH (read wstack s) /\
      wasm_entry code = SOME e /\ wasm_decl_vals code = SOME decls /\
      RTC wasm (wcall_entry code np nr (read wstack s) e decls s) c1 /\
      ~(read wstatus c1 = WRunning) /\
      s' = wcall_return npc np c1 s`;;
definition wasmc
 `wasmc (fs:num->byte list#num#num) s s' <=>
    wasm s s' \/
    read wstatus s = WRunning /\
    ?f n. wasm_decode (read wcode s) (val (read wpc s)) = SOME (Wcall f,n) /\
          wasm_call fs f (val (read wpc s) + n) s s'`;;
definition wasmf
 `wasmf (fs:num->byte list#num#num)
        (x:wasmstate#(wasmstate#num#num)list)
        (y:wasmstate#(wasmstate#num#num)list) <=>
    (wasm (FST x) (FST y) /\ SND y = SND x) \/
    (read wstatus (FST x) = WRunning /\
     ?f n code np nr e decls.
       wasm_decode (read wcode (FST x)) (val (read wpc (FST x))) =
         SOME (Wcall f,n) /\
       fs f = (code,np,nr) /\ np <= LENGTH (read wstack (FST x)) /\
       wasm_entry code = SOME e /\ wasm_decl_vals code = SOME decls /\
       FST y = wcall_entry code np nr (read wstack (FST x)) e decls (FST x) /\
       SND y = CONS (FST x,val (read wpc (FST x)) + n,np) (SND x)) \/
    (~(read wstatus (FST x) = WRunning) /\
     ?c npc np k. SND x = CONS (c,npc,np) k /\
                  FST y = wcall_return npc np (FST x) c /\ SND y = k)`;;
definition wasm_calln
 `wasm_calln (fs:num->byte list#num#num) f npc (s:wasmstate) (s':wasmstate) <=>
    ?code np nr e decls c1.
      fs f = (code,np,nr) /\ np <= LENGTH (read wstack s) /\
      wasm_entry code = SOME e /\ wasm_decl_vals code = SOME decls /\
      RTC (wasmf fs) (wcall_entry code np nr (read wstack s) e decls s,[])
                     (c1,[]) /\
      ~(read wstatus c1 = WRunning) /\
      s' = wcall_return npc np c1 s`;;
definition wasmn
 `wasmn (fs:num->byte list#num#num) s s' <=>
    wasm s s' \/
    read wstatus s = WRunning /\
    ?f n. wasm_decode (read wcode s) (val (read wpc s)) = SOME (Wcall f,n) /\
          wasm_calln fs f (val (read wpc s) + n) s s'`;;
(* ---- exact float model (verbatim from chain_c6a_final.spec 4082be06) ---- *)
definition wf_ebits
 `wf_ebits (a:N word) = if dimindex(:N) = 32 then 8 else 11`;;
definition wf_fbits
 `wf_fbits (a:N word) = dimindex(:N) - 1 - wf_ebits a`;;
definition wf_exp
 `wf_exp (a:N word) = (val a DIV 2 EXP wf_fbits a) MOD 2 EXP wf_ebits a`;;
definition wf_frac
 `wf_frac (a:N word) = val a MOD 2 EXP wf_fbits a`;;
definition wf_sign
 `wf_sign (a:N word) <=> val a DIV 2 EXP (dimindex(:N) - 1) = 1`;;
definition wf_nan
 `wf_nan (a:N word) <=> wf_exp a = 2 EXP wf_ebits a - 1 /\ ~(wf_frac a = 0)`;;
definition wf_inf
 `wf_inf (a:N word) <=> wf_exp a = 2 EXP wf_ebits a - 1 /\ wf_frac a = 0`;;
definition wf_key
 `wf_key (a:N word) =
    if wf_sign a then --(&(val a MOD 2 EXP (dimindex(:N) - 1)))
    else &(val a MOD 2 EXP (dimindex(:N) - 1)):int`;;
definition wf_mag
 `wf_mag (a:N word) =
    let bias = 2 EXP (wf_ebits a - 1) - 1 in
    let sig = if wf_exp a = 0 then wf_frac a else wf_frac a + 2 EXP wf_fbits a in
    let ee = if wf_exp a = 0 then 1 else wf_exp a in
    if bias + wf_fbits a <= ee then sig * 2 EXP (ee - (bias + wf_fbits a))
    else sig DIV 2 EXP ((bias + wf_fbits a) - ee)`;;
definition wf_trunc
 `wf_trunc (a:N word) = if wf_sign a then --(&(wf_mag a)) else &(wf_mag a):int`;;
definition wf_tidx
 `wf_tidx k = if 256 <= k then k - 256 else if k <= 0xAB then k - 0xA8 else k - 0xAA`;;
definition wf_tbits
 `wf_tbits k = if wf_tidx k < 4 then 32 else 64`;;
definition wf_tlo
 `wf_tlo k = if EVEN (wf_tidx k) then --(&2 pow (wf_tbits k - 1)) else &0:int`;;
definition wf_thi
 `wf_thi k = if EVEN (wf_tidx k) then &2 pow (wf_tbits k - 1) - &1
             else &2 pow wf_tbits k - &1:int`;;
definition wfrel
 `wfrel k (a:N word) (b:N word) <=>
    if k = 0x5C \/ k = 0x62 then wf_nan a \/ wf_nan b \/ ~(wf_key a = wf_key b)
    else ~wf_nan a /\ ~wf_nan b /\
         (if k = 0x5B \/ k = 0x61 then wf_key a = wf_key b
          else if k = 0x5D \/ k = 0x63 then wf_key a < wf_key b
          else if k = 0x5E \/ k = 0x64 then wf_key a > wf_key b
          else if k = 0x5F \/ k = 0x65 then wf_key a <= wf_key b
          else if k = 0x60 \/ k = 0x66 then wf_key a >= wf_key b
          else F)`;;
definition wftrap
 `wftrap k (a:M word) <=>
    (0xA8 <= k /\ k <= 0xAB \/ 0xAE <= k /\ k <= 0xB1) /\
    (wf_nan a \/ wf_inf a \/ ~(wf_tlo k <= wf_trunc a /\ wf_trunc a <= wf_thi k))`;;
(* ---- memory words (verbatim from va1_seq_final.spec df215f68 and chain_c6a_final.spec 4082be06) ---- *)
definition va1_tick
 `va1_tick (t:int32) (m:int64->byte) <=> read (bytes32 (word 16392)) m = t`;;
definition va1_pop
 `va1_pop (pt:int32) (ap:int32) (m:int64->byte) <=>
    read (bytes32 (word 16396)) m = pt /\ read (bytes32 (word 16512)) m = ap`;;
definition va1_mdl
 `va1_mdl (mdl:num->int32) (m:int64->byte) <=>
    !k. k < 1024 ==> read (bytes32 (word (16640 + 4 * k))) m = mdl k`;;
definition va1_vab
 `va1_vab N (x:(num->int32)#(num->int32)) (m:int64->byte) <=>
    (!j. j < 3 * N ==> read (bytes32 (word (1114112 + 4 * j))) m = FST x j) /\
    (!j. j < 3 * N ==> read (bytes32 (word (1122304 + 4 * j))) m = SND x j)`;;
definition va1_w32s
 `va1_w32s (base:num) (n:num) (f:num->int32) (m:int64->byte) <=>
    !k. k < n ==> read (bytes32 (word (base + 4 * k))) m = f k`;;
definition va1_rbinit
 `va1_rbinit (tbl:num->int32) (k:num) =
    let t0 = (word_sx (tbl (128 * k)):int64) in
    let t1 = (word_sx (tbl (128 * k + 1)):int64) in
    let x = word_add t0 (word_ishr (word_add (word_mul (word_sub t1 t0) (word 251658)) (word 262144)) 19) in
    let y = if ival x > &1 then x else word 1 in
    word_add (word_zx (word_ushr (word_add y (word 1)) 1)) (word 251658):int32`;;
definition va1_zpseed
 `va1_zpseed (mdl:num->int32) (k:num) =
    let h = word_xor (word_add (word_mul (mdl 2) (word 3266489909)) (word 2769733223))
                     (word_mul (word_xor (word k) (word 2654435769)) (word 2246822507)):int32 in
    let g = word_mul (word_xor (word_ushr h 15) h) (word 739982445):int32 in
    let u = word_xor (word_ushr g 12) g in
    word_zx (word_ishr (word_add (word_mul (word_zx u:int64) (word 329853)) (word 18446176457274163200)) 48):int32`;;
(* ---- the vortex field and the Fredkin step (verbatim from va1_seq_final.spec df215f68) ---- *)
definition ve_fredkin_fwd
 `ve_fredkin_fwd (f:(num->int32)->num->int32) (s:(num->int32)#(num->int32)) =
    (SND s,(\m. word_add (FST s m) (f (SND s) m)))`;;
definition ve_isq_step
 `ve_isq_step (x:int64#int64#int64) =
    if val (FST x) < val (word_add (SND (SND x)) (FST (SND x)))
    then (FST x, word_ushr (FST (SND x)) 1, word_ushr (SND (SND x)) 2)
    else (word_sub (FST x) (word_add (SND (SND x)) (FST (SND x))),
          word_add (SND (SND x)) (word_ushr (FST (SND x)) 1),
          word_ushr (SND (SND x)) 2)`;;
definition ve_vk_sx `ve_vk_sx (S:num->int32) i c = (word_sx (S (3 * i + c)):int64)`;;
definition ve_vk_ss
 `ve_vk_ss (S:num->int32) i =
    word_add (word_add (word_mul (ve_vk_sx S i 1) (ve_vk_sx S i 1))
                       (word_mul (ve_vk_sx S i 0) (ve_vk_sx S i 0)))
             (word_mul (ve_vk_sx S i 2) (ve_vk_sx S i 2))`;;
definition ve_vk_len
 `ve_vk_len (S:num->int32) i =
    let r = FST (SND (ve_isq 32 (ve_vk_ss S i, word 0, word 4611686018427387904))) in
    if ival r > &1 then r else (word 1:int64)`;;
definition ve_vk_xn
 `ve_vk_xn (S:num->int32) i c =
    (word_zx (iword (wtdiv (ival (word_shl (ve_vk_sx S i c) 30)) (ival (ve_vk_len S i))):int64)
     :int32)`;;
definition ve_vk_X `ve_vk_X (S:num->int32) i c = (word_sx (ve_vk_xn S i c):int64)`;;
definition ve_vk_C `ve_vk_C (mdl:num->int32) j = (word_sx (mdl (16 + j)):int64)`;;
definition ve_vk_w
 `ve_vk_w (X:num->num->int64) i j =
    let den = word_sub (word 1076426179)
                (word_ishr (word_add (word_add (word_mul (X j 1) (X i 1))
                                               (word_mul (X j 0) (X i 0)))
                                     (word_mul (X j 2) (X i 2))) 30) in
    word_udiv (word 18014398509481984) (if ival den > &2684355 then den else word 2684355)`;;
definition ve_vk_v
 `ve_vk_v (X:num->num->int64) i j c =
    if c = 0 then word_sub (word_mul (X j 1) (X i 2)) (word_mul (X j 2) (X i 1))
    else if c = 1 then word_sub (word_mul (X j 2) (X i 0)) (word_mul (X j 0) (X i 2))
    else word_sub (word_mul (X j 0) (X i 1)) (word_mul (X j 1) (X i 0))`;;
definition ve_vk_tj
 `ve_vk_tj (X:num->num->int64) (C:num->int64) i j c =
    word_ishr (word_mul (word_ishr (word_mul (ve_vk_w X i j) (C i)) 20)
                        (word_ishr (word_sub (word 0) (ve_vk_v X i j c)) 36)) 12`;;
definition ve_vk_ti
 `ve_vk_ti (X:num->num->int64) (C:num->int64) i j c =
    word_ishr (word_mul (word_ishr (word_mul (ve_vk_w X i j) (C j)) 20)
                        (word_ishr (ve_vk_v X i j c) 36)) 12`;;
definition ve_vk_upd
 `ve_vk_upd (X:num->num->int64) (C:num->int64) i j c (a:int64) =
    if c = 2 then word_add a (ve_vk_tj X C i j c) else word_add (ve_vk_tj X C i j c) a`;;
definition ve_vk_rnd
 `ve_vk_rnd (a:int64) = (word_zx (word_ishr (word_add a (word 34359738368)) 36):int32)`;;
definition ve_vk
 `ve_vk (mdl:num->int32) (S:num->int32) m =
    ve_vk_rnd (ve_vk_acc (ve_vk_X S) (ve_vk_C mdl) (MIN (val (mdl 1)) 640)
                         (MIN (val (mdl 1)) 640) (m DIV 3) (m MOD 3))`;;
