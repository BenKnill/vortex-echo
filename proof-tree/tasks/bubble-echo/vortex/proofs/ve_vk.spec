    let tt = ve_t s - ve_pt s in let b = ve_bs s in let c = ve_cnt b in
    let r = ve_kd_bwd (ve_dmask c (kd tt c)) (ve_dmask c (dd tt c)) (ve_dq b,ve_dp b) in
