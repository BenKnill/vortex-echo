definition ve_rim_fwd
 `ve_rim_fwd (fr:(num->int32)->(num->int32)->num->int32) s =
    let r = ve_fredkin_fwd (fr (ve_hm s)) (ve_ra s,ve_rb s) in
    (ve_t s,ve_pt s,ve_va s,ve_vb s,ve_hm s,FST r,SND r,ve_jq s,ve_jp s,ve_bs s)`;;
