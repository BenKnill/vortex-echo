(* ---- host-call layer: definitions ---- *)
definition va1_hcall
 `va1_hcall (step:wasmstate->wasmstate->bool) (code:byte list) (args:wval list) (r:int32)
            (Q:(num->wval)->(int64->byte)->bool) (gl:num->wval) (m:int64->byte) <=>
    ?e decls.
      wasm_entry code = SOME e /\ wasm_decl_vals code = SOME decls /\
      !s0. read wmemsize s0 = 4194304 /\ read wglobals s0 = gl /\ read wmem s0 = m
           ==> eventually step
                 (\s. read wstatus s = WDone /\ read wstack s = [I32 r] /\
                      read wmemsize s = 4194304 /\ Q (read wglobals s) (read wmem s))
                 (wcall_entry code (LENGTH args) 1 args e decls s0)`;;
definition va1_hrun
 `va1_hrun (step:wasmstate->wasmstate->bool) (cs:bool list) (Q:(num->wval)->(int64->byte)->bool) =
    ITLIST (\c R. va1_hcall step (if c then va1_tick_forward_mc else va1_tick_backward_mc) [] (word 1) R) cs Q`;;
allow va1_cmds_ok;;
allow va1_cmds_end;;
theorem VA1_HRUN_CLAUSES
 `(!(step:wasmstate->wasmstate->bool) (Q:(num->wval)->(int64->byte)->bool) gl m.
     va1_hrun step [] Q gl m <=> Q gl m) /\
  (!(step:wasmstate->wasmstate->bool) c cs (Q:(num->wval)->(int64->byte)->bool) gl m.
     va1_hrun step (CONS c cs) Q gl m <=>
     va1_hcall step (if c then va1_tick_forward_mc else va1_tick_backward_mc) [] (word 1)
               (va1_hrun step cs Q) gl m)`;;
theorem VA1_CMDS_OK_CLAUSES
 `(!K u. va1_cmds_ok K u [] <=> T) /\
  (!K u c cs. va1_cmds_ok K u (CONS c cs) <=>
     if c then u < K /\ va1_cmds_ok K (u + 1) cs else 0 < u /\ va1_cmds_ok K (u - 1) cs)`;;
theorem VA1_CMDS_END_CLAUSES
 `(!u. va1_cmds_end u [] = u) /\
  (!u c cs. va1_cmds_end u (CONS c cs) = va1_cmds_end (if c then u + 1 else u - 1) cs)`;;

(* ---- host-call layer: generic theorems ---- *)
theorem VA1_HCALL_ENSURES
 `!(step:wasmstate->wasmstate->bool) (code:byte list) (e:num) (decls:wval list) (args:wval list) (r:int32)
   (P:wasmstate->bool) (Q:wasmstate->bool) (C:wasmstate->wasmstate->bool)
   (R:(num->wval)->(int64->byte)->bool) (gl:num->wval) (m:int64->byte).
     wasm_entry code = SOME e /\ wasm_decl_vals code = SOME decls /\ ensures step P Q C /\
     (!s0. read wmemsize s0 = 4194304 /\ read wglobals s0 = gl /\ read wmem s0 = m
           ==> P (wcall_entry code (LENGTH args) 1 args e decls s0)) /\
     (!s0 s. read wmemsize s0 = 4194304 /\ read wglobals s0 = gl /\ read wmem s0 = m /\
             Q s /\ C (wcall_entry code (LENGTH args) 1 args e decls s0) s
             ==> read wstatus s = WDone /\ read wstack s = [I32 r] /\
                 read wmemsize s = 4194304 /\ R (read wglobals s) (read wmem s))
     ==> va1_hcall step code args r R gl m`;;
theorem VA1_HCALL_MONO
 `!(step:wasmstate->wasmstate->bool) (code:byte list) (args:wval list) (r:int32)
   (Q:(num->wval)->(int64->byte)->bool) (Q':(num->wval)->(int64->byte)->bool) (gl:num->wval) (m:int64->byte).
     (!g x. Q g x ==> Q' g x) /\ va1_hcall step code args r Q gl m
     ==> va1_hcall step code args r Q' gl m`;;
theorem VA1_HRUN_MONO
 `!(step:wasmstate->wasmstate->bool) (cs:bool list)
   (Q:(num->wval)->(int64->byte)->bool) (Q':(num->wval)->(int64->byte)->bool) (gl:num->wval) (m:int64->byte).
     (!g x. Q g x ==> Q' g x) /\ va1_hrun step cs Q gl m
     ==> va1_hrun step cs Q' gl m`;;
theorem VA1_HRUN_APPEND
 `!(step:wasmstate->wasmstate->bool) (cs1:bool list) (cs2:bool list) (Q:(num->wval)->(int64->byte)->bool).
     va1_hrun step (APPEND cs1 cs2) Q = va1_hrun step cs1 (va1_hrun step cs2 Q)`;;
theorem VA1_HCALL_START_SAT
 `!(gl:num->wval) (m:int64->byte).
     ?s0. read wmemsize s0 = 4194304 /\ read wglobals s0 = gl /\ read wmem s0 = m`;;
theorem VA1_HCALL_RUNS
 `!(fs:num->byte list#num#num) (code:byte list) (args:wval list) (r:int32)
   (Q:(num->wval)->(int64->byte)->bool) (gl:num->wval) (m:int64->byte).
     va1_hcall (wasmc fs) code args r Q gl m
     ==> ?e decls.
           wasm_entry code = SOME e /\ wasm_decl_vals code = SOME decls /\
           !s0. read wmemsize s0 = 4194304 /\ read wglobals s0 = gl /\ read wmem s0 = m
                ==> (?s. RTC (wasmc fs) (wcall_entry code (LENGTH args) 1 args e decls s0) s /\
                         read wstatus s = WDone /\ read wstack s = [I32 r] /\
                         read wmemsize s = 4194304 /\ Q (read wglobals s) (read wmem s)) /\
                    (!s. RTC (wasmc fs) (wcall_entry code (LENGTH args) 1 args e decls s0) s /\
                         ~(read wstatus s = WRunning)
                         ==> read wstatus s = WDone /\ read wstack s = [I32 r] /\
                             read wmemsize s = 4194304 /\ Q (read wglobals s) (read wmem s))`;;
theorem VA1_TICKF_CALLEE
 `wasm_entry va1_tick_forward_mc = SOME 3 /\
  wasm_decl_vals va1_tick_forward_mc = SOME [I32 (word 0); I32 (word 0); I32 (word 0)]`;;
theorem VA1_TICKB_CALLEE
 `wasm_entry va1_tick_backward_mc = SOME 3 /\
  wasm_decl_vals va1_tick_backward_mc = SOME [I32 (word 0); I32 (word 0)]`;;

(* ---- no-pop chain: definitions ---- *)
definition va1_swf
 `va1_swf (mdl:num->int32) = ve_fredkin_fwdn (\i. ve_vk mdl) 16`;;
definition va1_swb
 `va1_swb (mdl:num->int32) = ve_fredkin_bwdn (\i. ve_vk mdl) 16`;;
definition va1_np_st
 `va1_np_st (t:int32) (ap:int32) (mdl:num->int32) (N:num) (x:(num->int32)#(num->int32)) (m:int64->byte) <=>
    va1_tick t m /\ va1_pop (word 4294967295) ap m /\ va1_mdl mdl m /\ va1_vab N x m`;;
definition va1_fs_np
 `va1_fs_np (fs:num->byte list#num#num) <=>
    fs 9 = (va1_f9_mc,0,0) /\ fs 10 = (va1_f10_mc,0,0) /\ fs 27 = (va1_f27_mc,0,0) /\ fs 28 = (va1_f28_mc,0,0)`;;
definition va1_np_frame
 `va1_np_frame (m0:int64->byte) (m:int64->byte) <=>
    !a. a < 4194304 /\ ~(16392 <= a /\ a < 16396) /\ ~(1114112 <= a /\ a < 1130496) /\
        ~(1966080 <= a /\ a < 2039808)
        ==> read (bytes8 (word a)) m = read (bytes8 (word a)) m0`;;

(* ---- no-pop chain: one host call per tick ---- *)
theorem VA1_NP_HCALL_FWD
 `!(fs:num->byte list#num#num) (gl:num->wval) (t:int32) (ap:int32) (mdl:num->int32) (N:num)
   (x:(num->int32)#(num->int32)) (m:int64->byte).
     mdl 1 = word N /\ 1 <= N /\ N <= 640 /\ va1_fs_np fs /\
     (ap = word 0 \/ ~(ap = word_add t (word 1))) /\ va1_np_st t ap mdl N x m
     ==> va1_hcall (wasmc fs) va1_tick_forward_mc [] (word 1)
           (\gl' m'. gl' = gl /\ va1_np_st (word_add t (word 1)) ap mdl N (va1_swf mdl x) m') gl m`;;
theorem VA1_NP_HCALL_BWD
 `!(fs:num->byte list#num#num) (gl:num->wval) (u:int32) (ap:int32) (mdl:num->int32) (N:num)
   (y:(num->int32)#(num->int32)) (m:int64->byte).
     mdl 1 = word N /\ 1 <= N /\ N <= 640 /\ va1_fs_np fs /\ ~(u = word 0) /\ va1_np_st u ap mdl N y m
     ==> va1_hcall (wasmc fs) va1_tick_backward_mc [] (word 1)
           (\gl' m'. gl' = gl /\ va1_np_st (word_sub u (word 1)) ap mdl N (va1_swb mdl y) m') gl m`;;

(* ---- no-pop chain: scrub in any order, the film, non-vacuity ---- *)
theorem VA1_NP_SCRUB
 `!(fs:num->byte list#num#num) (gl:num->wval) (mdl:num->int32) (N:num) (ap:int32)
   (x0:(num->int32)#(num->int32)) (K:num).
     mdl 1 = word N /\ 1 <= N /\ N <= 640 /\ va1_fs_np fs /\ K < 4294967296 /\
     (ap = word 0 \/ K < val ap)
     ==> !(cs:bool list) (u:num) (m:int64->byte).
           u <= K /\ va1_cmds_ok K u cs /\
           va1_np_st (word u) ap mdl N (ITER u (va1_swf mdl) x0) m
           ==> va1_hrun (wasmc fs) cs
                 (\gl' m'. gl' = gl /\
                    va1_np_st (word (va1_cmds_end u cs)) ap mdl N
                              (ITER (va1_cmds_end u cs) (va1_swf mdl) x0) m') gl m`;;
theorem VA1_NP_FILM_INVERSE
 `!(fs:num->byte list#num#num) (gl:num->wval) (mdl:num->int32) (N:num)
   (x0:(num->int32)#(num->int32)) (n:num) (m:int64->byte).
     mdl 1 = word N /\ 1 <= N /\ N <= 640 /\ va1_fs_np fs /\ n < 4294967296 /\
     va1_np_st (word 0) (word 0) mdl N x0 m
     ==> va1_hrun (wasmc fs) (APPEND (REPLICATE n T) (REPLICATE n F))
           (\gl' m'. gl' = gl /\ va1_np_st (word 0) (word 0) mdl N x0 m') gl m`;;
theorem VA1_NP_FILM_SAT
 `(?fs:num->byte list#num#num. va1_fs_np fs) /\
  (!(t:int32) (ap:int32) (mdl:num->int32) (N:num) (x:(num->int32)#(num->int32)).
     N <= 640 ==> ?m:int64->byte. va1_np_st t ap mdl N x m)`;;

(* ---- C1b: the byte frame ---- *)
theorem VA1_NP_SCRUB_FRAME
 `!(fs:num->byte list#num#num) (gl:num->wval) (mdl:num->int32) (N:num) (ap:int32)
   (x0:(num->int32)#(num->int32)) (K:num).
     mdl 1 = word N /\ 1 <= N /\ N <= 640 /\ va1_fs_np fs /\ K < 4294967296 /\
     (ap = word 0 \/ K < val ap)
     ==> !(cs:bool list) (u:num) (m:int64->byte).
           u <= K /\ va1_cmds_ok K u cs /\
           va1_np_st (word u) ap mdl N (ITER u (va1_swf mdl) x0) m
           ==> va1_hrun (wasmc fs) cs
                 (\gl' m'. gl' = gl /\
                    va1_np_st (word (va1_cmds_end u cs)) ap mdl N
                              (ITER (va1_cmds_end u cs) (va1_swf mdl) x0) m' /\
                    va1_np_frame m m') gl m`;;
theorem VA1_NP_FILM_BYTES
 `!(fs:num->byte list#num#num) (gl:num->wval) (mdl:num->int32) (N:num)
   (x0:(num->int32)#(num->int32)) (n:num) (m:int64->byte).
     mdl 1 = word N /\ 1 <= N /\ N <= 640 /\ va1_fs_np fs /\ n < 4294967296 /\
     va1_np_st (word 0) (word 0) mdl N x0 m
     ==> va1_hrun (wasmc fs) (APPEND (REPLICATE n T) (REPLICATE n F))
           (\gl' m'. gl' = gl /\ va1_np_st (word 0) (word 0) mdl N x0 m' /\ va1_np_frame m m') gl m`;;

(* ---- PROVED inputs, re-stated verbatim (ve_vk.spec; va1_seq_final.spec df215f68) and the copied pins ---- *)
theorem VE_VORT_STEPS_INVERSE_VK
 `!(mdl:num->int32) n s.
     ve_fredkin_bwdn (\i. ve_vk mdl) n (ve_fredkin_fwdn (\i. ve_vk mdl) n s) = s`;;
theorem VA1_TICK_FORWARD_NOPOP_VK
 `!fs gl t ap mdl N x.
     mdl 1 = word N /\ 1 <= N /\ N <= 640 /\
     fs 9 = (va1_f9_mc,0,0) /\ fs 27 = (va1_f27_mc,0,0) /\
     (ap = word 0 \/ ~(ap = word_add t (word 1)))
     ==> ensures (wasmc fs)
          (\s. read wcode s = va1_tick_forward_mc /\ read wpc s = word 3 /\
               read wstatus s = WRunning /\ read wstack s = [] /\
               read wlabels s = [] /\ read warity s = 1 /\
               read wmemsize s = 4194304 /\ read wglobals s = gl /\
               va1_tick t (read wmem s) /\
               va1_pop (word 4294967295) ap (read wmem s) /\
               va1_mdl mdl (read wmem s) /\ va1_vab N x (read wmem s))
          (\s. read wstatus s = WDone /\ read wstack s = [I32 (word 1)] /\
               va1_tick (word_add t (word 1)) (read wmem s) /\
               va1_pop (word 4294967295) ap (read wmem s) /\
               va1_mdl mdl (read wmem s) /\
               va1_vab N (ve_fredkin_fwdn (\i. ve_vk mdl) 16 x) (read wmem s))
          (MAYCHANGE [wpc] ,, MAYCHANGE [wstack] ,, MAYCHANGE [wlabels] ,,
           MAYCHANGE [wstatus] ,, MAYCHANGE [wlocal 0; wlocal 1; wlocal 2] ,,
           MAYCHANGE [wmem :> bytes(word 16392,4)] ,,
           MAYCHANGE [wmem :> bytes(word 1114112,16384)] ,,
           MAYCHANGE [wmem :> bytes(word 1966080,73728)])`;;
theorem VA1_TICK_BACKWARD_NOPOP_VK
 `!fs gl u ap mdl N y.
     mdl 1 = word N /\ 1 <= N /\ N <= 640 /\
     fs 10 = (va1_f10_mc,0,0) /\ fs 28 = (va1_f28_mc,0,0) /\
     ~(u = word 0)
     ==> ensures (wasmc fs)
          (\s. read wcode s = va1_tick_backward_mc /\ read wpc s = word 3 /\
               read wstatus s = WRunning /\ read wstack s = [] /\
               read wlabels s = [] /\ read warity s = 1 /\
               read wmemsize s = 4194304 /\ read wglobals s = gl /\
               va1_tick u (read wmem s) /\
               va1_pop (word 4294967295) ap (read wmem s) /\
               va1_mdl mdl (read wmem s) /\ va1_vab N y (read wmem s))
          (\s. read wstatus s = WDone /\ read wstack s = [I32 (word 1)] /\
               va1_tick (word_sub u (word 1)) (read wmem s) /\
               va1_pop (word 4294967295) ap (read wmem s) /\
               va1_mdl mdl (read wmem s) /\
               va1_vab N (ve_fredkin_bwdn (\i. ve_vk mdl) 16 y) (read wmem s))
          (MAYCHANGE [wpc] ,, MAYCHANGE [wstack] ,, MAYCHANGE [wlabels] ,,
           MAYCHANGE [wstatus] ,, MAYCHANGE [wlocal 0; wlocal 1] ,,
           MAYCHANGE [wmem :> bytes(word 16392,4)] ,,
           MAYCHANGE [wmem :> bytes(word 1114112,16384)] ,,
           MAYCHANGE [wmem :> bytes(word 1966080,73728)])`;;
theorem VA1_FWDN_CLAUSES
 `(!f s. ve_fredkin_fwdn f 0 s = s) /\
   (!f n s. ve_fredkin_fwdn f (SUC n) s = ve_fredkin_fwd (f n) (ve_fredkin_fwdn f n s))`;;
theorem VA1_BWDN_CLAUSES
 `(!f s. ve_fredkin_bwdn f 0 s = s) /\
   (!f n s. ve_fredkin_bwdn f (SUC n) s = ve_fredkin_bwdn f n (ve_fredkin_bwd (f n) s))`;;
theorem VA1_ISQ_CLAUSES
 `(!x. ve_isq 0 x = x) /\ (!k x. ve_isq (SUC k) x = ve_isq_step (ve_isq k x))`;;
theorem VA1_VK_RS_CLAUSES
 `(!X C i c. ve_vk_rs X C i 0 c = word 0) /\
   (!X C i k c. ve_vk_rs X C i (SUC k) c = word_add (ve_vk_ti X C i (i + 1 + k) c) (ve_vk_rs X C i k c))`;;
theorem VA1_VK_ACC_CLAUSES
 `(!X C n j c. ve_vk_acc X C n 0 j c = word 0) /\
   (!X C n i j c. ve_vk_acc X C n (SUC i) j c =
      if j = i then word_add (ve_vk_acc X C n i j c) (ve_vk_rs X C i (n - 1 - i) c)
      else if i < j then ve_vk_upd X C i j c (ve_vk_acc X C n i j c)
      else ve_vk_acc X C n i j c)`;;
theorem VA1_WDECL_VALS_CLAUSES
 `(!code pc. wdecl_vals 0 (code:byte list) pc = SOME ([]:wval list)) /\
  (!k code pc. wdecl_vals (SUC k) code pc =
     wobind (wuleb (wdrop pc code)) (\p.
     wobind (whd (wdrop (pc + SND p) code)) (\t.
     wobind (wdecl_vals k code (pc + SND p + 1)) (\r.
       SOME (APPEND (REPLICATE (FST p) (wzero_of (val (t:byte)))) r)))))`;;
definition ve_fredkin_fwd
 `ve_fredkin_fwd (f:(num->int32)->num->int32) (s:(num->int32)#(num->int32)) =
    (SND s,(\m. word_add (FST s m) (f (SND s) m)))`;;
definition ve_fredkin_bwd
 `ve_fredkin_bwd (f:(num->int32)->num->int32) (s:(num->int32)#(num->int32)) =
    ((\m. word_sub (SND s m) (f (FST s) m)),FST s)`;;
definition ve_vk_sx `ve_vk_sx (S:num->int32) i c = (word_sx (S (3 * i + c)):int64)`;;
definition ve_vk_ss
 `ve_vk_ss (S:num->int32) i =
    word_add (word_add (word_mul (ve_vk_sx S i 1) (ve_vk_sx S i 1))
                       (word_mul (ve_vk_sx S i 0) (ve_vk_sx S i 0)))
             (word_mul (ve_vk_sx S i 2) (ve_vk_sx S i 2))`;;
definition ve_vk_len
 `ve_vk_len (S:num->int32) i =
    let r = FST (SND (ve_isq 32 (ve_vk_ss S i, word 0, word 4611686018427387904))) in
    if ival r > &1 then r else (word 1:int64)`;;
definition ve_vk_xn
 `ve_vk_xn (S:num->int32) i c =
    (word_zx (iword (wtdiv (ival (word_shl (ve_vk_sx S i c) 30)) (ival (ve_vk_len S i))):int64)
     :int32)`;;
definition ve_vk_X `ve_vk_X (S:num->int32) i c = (word_sx (ve_vk_xn S i c):int64)`;;
definition ve_vk_C `ve_vk_C (mdl:num->int32) j = (word_sx (mdl (16 + j)):int64)`;;
definition ve_vk_rnd
 `ve_vk_rnd (a:int64) = (word_zx (word_ishr (word_add a (word 34359738368)) 36):int32)`;;
definition ve_vk
 `ve_vk (mdl:num->int32) (S:num->int32) m =
    ve_vk_rnd (ve_vk_acc (ve_vk_X S) (ve_vk_C mdl) (MIN (val (mdl 1)) 640)
                         (MIN (val (mdl 1)) 640) (m DIV 3) (m MOD 3))`;;
definition wasm_decl_vals
 `wasm_decl_vals (code:byte list) =
    wobind (wuleb code) (\p. wdecl_vals (FST p) code (SND p))`;;
definition wcall_locals
 `wcall_locals (args:wval list) (decls:wval list) (k:num) =
    if k < LENGTH args then EL (LENGTH args - 1 - k) args
    else if k - LENGTH args < LENGTH decls then EL (k - LENGTH args) decls
    else I32 (word 0)`;;
definition wcall_entry
 `wcall_entry (code:byte list) np nr (stk:wval list) e (decls:wval list)
              (s:wasmstate) =
    write wcode code
     (write wpc (word e)
       (write wstack []
         (write wlocals (wcall_locals (wtake np stk) decls)
           (write wlabels []
             (write warity nr
               (write wstatus WRunning s))))))`;;
definition wcall_return
 `wcall_return npc np (c1:wasmstate) (s:wasmstate) =
    if read wstatus c1 = WDone
    then write wpc (word npc)
          (write wstack (APPEND (read wstack c1) (wdrop np (read wstack s)))
            (write wmem (read wmem c1)
              (write wmemsize (read wmemsize c1)
                (write wglobals (read wglobals c1) s))))
    else write wstatus WTrapped
          (write wmem (read wmem c1)
            (write wmemsize (read wmemsize c1)
              (write wglobals (read wglobals c1) s)))`;;
definition wasm_call
 `wasm_call (fs:num->byte list#num#num) f npc (s:wasmstate) (s':wasmstate) <=>
    ?code np nr e decls c1.
      fs f = (code,np,nr) /\ np <= LENGTH (read wstack s) /\
      wasm_entry code = SOME e /\ wasm_decl_vals code = SOME decls /\
      RTC wasm (wcall_entry code np nr (read wstack s) e decls s) c1 /\
      ~(read wstatus c1 = WRunning) /\
      s' = wcall_return npc np c1 s`;;
definition wasmc
 `wasmc (fs:num->byte list#num#num) s s' <=>
    wasm s s' \/
    read wstatus s = WRunning /\
    ?f n. wasm_decode (read wcode s) (val (read wpc s)) = SOME (Wcall f,n) /\
          wasm_call fs f (val (read wpc s) + n) s s'`;;
definition va1_tick
 `va1_tick (t:int32) (m:int64->byte) <=> read (bytes32 (word 16392)) m = t`;;
definition va1_pop
 `va1_pop (pt:int32) (ap:int32) (m:int64->byte) <=>
    read (bytes32 (word 16396)) m = pt /\ read (bytes32 (word 16512)) m = ap`;;
definition va1_mdl
 `va1_mdl (mdl:num->int32) (m:int64->byte) <=>
    !k. k < 1024 ==> read (bytes32 (word (16640 + 4 * k))) m = mdl k`;;
definition va1_vab
 `va1_vab N (x:(num->int32)#(num->int32)) (m:int64->byte) <=>
    (!j. j < 3 * N ==> read (bytes32 (word (1114112 + 4 * j))) m = FST x j) /\
    (!j. j < 3 * N ==> read (bytes32 (word (1122304 + 4 * j))) m = SND x j)`;;
definition ve_isq_step
 `ve_isq_step (x:int64#int64#int64) =
    if val (FST x) < val (word_add (SND (SND x)) (FST (SND x)))
    then (FST x, word_ushr (FST (SND x)) 1, word_ushr (SND (SND x)) 2)
    else (word_sub (FST x) (word_add (SND (SND x)) (FST (SND x))),
          word_add (SND (SND x)) (word_ushr (FST (SND x)) 1),
          word_ushr (SND (SND x)) 2)`;;
definition ve_vk_w
 `ve_vk_w (X:num->num->int64) i j =
    let den = word_sub (word 1076426179)
                (word_ishr (word_add (word_add (word_mul (X j 1) (X i 1))
                                               (word_mul (X j 0) (X i 0)))
                                     (word_mul (X j 2) (X i 2))) 30) in
    word_udiv (word 18014398509481984) (if ival den > &2684355 then den else word 2684355)`;;
definition ve_vk_v
 `ve_vk_v (X:num->num->int64) i j c =
    if c = 0 then word_sub (word_mul (X j 1) (X i 2)) (word_mul (X j 2) (X i 1))
    else if c = 1 then word_sub (word_mul (X j 2) (X i 0)) (word_mul (X j 0) (X i 2))
    else word_sub (word_mul (X j 0) (X i 1)) (word_mul (X j 1) (X i 0))`;;
definition ve_vk_tj
 `ve_vk_tj (X:num->num->int64) (C:num->int64) i j c =
    word_ishr (word_mul (word_ishr (word_mul (ve_vk_w X i j) (C i)) 20)
                        (word_ishr (word_sub (word 0) (ve_vk_v X i j c)) 36)) 12`;;
definition ve_vk_ti
 `ve_vk_ti (X:num->num->int64) (C:num->int64) i j c =
    word_ishr (word_mul (word_ishr (word_mul (ve_vk_w X i j) (C j)) 20)
                        (word_ishr (ve_vk_v X i j c) 36)) 12`;;
definition ve_vk_upd
 `ve_vk_upd (X:num->num->int64) (C:num->int64) i j c (a:int64) =
    if c = 2 then word_add a (ve_vk_tj X C i j c) else word_add (ve_vk_tj X C i j c) a`;;
definition wzero_of
 `wzero_of (t:num) =
    if t = 0x7E then I64 (word 0) else if t = 0x7D then F32 (word 0)
    else if t = 0x7C then F64 (word 0) else I32 (word 0)`;;
